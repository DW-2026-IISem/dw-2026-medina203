### Feature GarmentTypes — CREATE (JWT + RBAC)
@baseUrl = http://localhost:4000
# access_token: POST /api/sesion/login (features/auth/session/http/session.http) o npm run dev:token -- admin
@token = pega-aqui-el-access-token

### CREATE → 201
POST {{baseUrl}}/api/tipos-prenda
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "name": "Tapetes",
  "description": "Tapetes de baño y de entrada"
}

### CREATE con nombre repetido → 409
POST {{baseUrl}}/api/tipos-prenda
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "name": "Tapetes"
}
