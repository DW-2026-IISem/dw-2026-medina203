### Feature LaundryServices — CREATE (JWT + RBAC)
@baseUrl = http://localhost:4000
# access_token: POST /api/sesion/login (features/auth/session/http/session.http) o npm run dev:token -- admin
@token = pega-aqui-el-access-token

### CREATE cobro por kg → 201
POST {{baseUrl}}/api/servicios
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "name": "Lavado industrial - Sábanas",
  "description": "Lavado, secado y doblado",
  "price": 5500,
  "billing_unit": "kg",
  "estimated_hours": 24,
  "garment_type_id": 1
}

### CREATE cobro por unidad → 201
POST {{baseUrl}}/api/servicios
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "name": "Planchado - Uniformes",
  "price": 2500,
  "billing_unit": "unit",
  "garment_type_id": 7
}

### CREATE con tipo de prenda inexistente → 404
POST {{baseUrl}}/api/servicios
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "name": "Servicio inválido",
  "price": 1000,
  "billing_unit": "kg",
  "garment_type_id": 9999
}
