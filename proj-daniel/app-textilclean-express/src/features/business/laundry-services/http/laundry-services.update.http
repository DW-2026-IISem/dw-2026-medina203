### Feature LaundryServices — UPDATE PUT / PATCH (JWT + RBAC)
@baseUrl = http://localhost:4000
# access_token: POST /api/sesion/login (features/auth/session/http/session.http) o npm run dev:token -- admin
@token = pega-aqui-el-access-token

### PUT
PUT {{baseUrl}}/api/servicios/1
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "name": "Lavado industrial - Sábanas",
  "description": "Lavado, secado y doblado",
  "price": 6000,
  "billing_unit": "kg",
  "estimated_hours": 24,
  "garment_type_id": 1
}

### PATCH (solo precio)
PATCH {{baseUrl}}/api/servicios/1
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "price": 6200
}
