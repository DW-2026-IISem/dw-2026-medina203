{
  "name": "app-textilclean-express",
  "version": "1.0.0",
  "description": "Backend TextilClean - Lavandería industrial (Express 5 + TypeScript + Sequelize)",
  "main": "dist/server.js",
  "type": "commonjs",
  "scripts": {
    "build": "tsc",
    "dev": "nodemon --watch src --ext ts --exec ts-node -- src/server.ts",
    "start": "node dist/server.js",
    "db:seed": "ts-node -- src/database/seeders/index.ts",
    "db:seed:catalog": "ts-node -- src/database/seeders/catalog.ts",
    "typecheck": "tsc --noEmit",
    "dev:token": "ts-node -- src/scripts/dev-token.ts",
    "smoke": "ts-node -- src/scripts/smoke-e2e.ts",
    "test:reconcile": "ts-node -- src/scripts/test-reconcile.ts"
  },
  "keywords": [
    "textilclean",
    "lavanderia",
    "express",
    "sequelize"
  ],
  "author": "Daniel David Medina Velasquez",
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.12.1",
    "mysql2": "^3.24.6",
    "oracledb": "^26.0.0",
    "pg": "^8.23.1",
    "pg-hstore": "^2.3.4",
    "sequelize": "^6.37.8",
    "swagger-ui-express": "^5.0.1",
    "tedious": "^20.4.1"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.6.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/node": "^22.20.5",
    "@types/swagger-ui-express": "^4.1.8",
    "nodemon": "^3.1.14",
    "ts-node": "^10.9.2",
    "typescript": "~5.9"
  }
}
