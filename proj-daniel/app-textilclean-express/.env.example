# ===== Servidor =====
PORT=4000
NODE_ENV=development

# ===== Motor de base de datos: mysql | postgres =====
DB_ENGINE=mysql
# true = borra y recrea todas las tablas al arrancar (solo desarrollo)
DB_SYNC_FORCE=false

# ===== MySQL =====
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_NAME=textilclean_db

# ===== PostgreSQL =====
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_NAME=textilclean_db

# ===== SQL Server (configuración previa, sin adaptador aún) =====
MSSQL_HOST=localhost
MSSQL_PORT=1433
MSSQL_USER=sa
MSSQL_PASSWORD=
MSSQL_NAME=textilclean_db

# ===== Oracle (configuración previa, sin adaptador aún) =====
ORACLE_HOST=localhost
ORACLE_PORT=1521
ORACLE_USER=system
ORACLE_PASSWORD=
ORACLE_NAME=XEPDB1

# ===== Seguridad (Fase II) =====
# Secreto HS256 de al menos 32 caracteres. Generar con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=cambia-este-secreto-por-uno-largo-y-aleatorio-de-48-bytes
# Vida del access token en segundos (15 min)
JWT_ACCESS_TTL=900
# Vida del refresh token en días
JWT_REFRESH_TTL_DAYS=7
